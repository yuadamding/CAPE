{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-feature-selection-result.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Common-support feature result that can parent sample-size selection.",
  "properties": {
    "common_support_metric_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "curve": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "fit_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fit Rows Hash",
      "type": "string"
    },
    "metric_unit": {
      "const": "nats_per_weighted_validation_count",
      "default": "nats_per_weighted_validation_count",
      "title": "Metric Unit",
      "type": "string"
    },
    "ordered_features": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "refit_records": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_at_reference": {
      "title": "Selected At Reference",
      "type": "boolean"
    },
    "selected_feature_count": {
      "enum": [
        256,
        512,
        1024,
        2048,
        4096
      ],
      "title": "Selected Feature Count",
      "type": "integer"
    },
    "selected_feature_order_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selected Feature Order Sha256",
      "type": "string"
    },
    "validation_count_total_identical_across_candidates": {
      "const": true,
      "default": true,
      "title": "Validation Count Total Identical Across Candidates",
      "type": "boolean"
    },
    "validation_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Rows Hash",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "curve",
    "refit_records",
    "ordered_features",
    "common_support_metric_receipt",
    "fit_rows_hash",
    "validation_rows_hash",
    "selected_feature_count",
    "selected_feature_order_sha256",
    "selected_at_reference"
  ],
  "title": "G00CFeatureSelectionResultV3",
  "type": "object"
}
