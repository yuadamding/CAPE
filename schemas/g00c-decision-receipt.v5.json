{
  "$id": "https://credo.local/schemas/g00c-decision-receipt.v5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Dev37 terminal decision created after the immutable inner publication.",
  "properties": {
    "biological_claims": {
      "const": false,
      "default": false,
      "title": "Biological Claims",
      "type": "boolean"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "execution_bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Bundle Id",
      "type": "string"
    },
    "feature_ranking_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Ranking Receipt Id",
      "type": "string"
    },
    "feature_refit_replay_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Refit Replay Receipt Id",
      "type": "string"
    },
    "feature_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Selection Result Id",
      "type": "string"
    },
    "inner_publication_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inner Publication Manifest Id",
      "type": "string"
    },
    "materialization_receipt_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Materialization Receipt Id"
    },
    "may_parent_g00d": {
      "title": "May Parent G00D",
      "type": "boolean"
    },
    "monitor_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Monitor Receipt Id",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "sample_refit_replay_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Refit Replay Receipt Id",
      "type": "string"
    },
    "sample_size_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Size Selection Result Id",
      "type": "string"
    },
    "sampler_evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampler Evidence Id",
      "type": "string"
    },
    "sampler_restart_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampler Restart Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 5,
      "default": 5,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection_freeze_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Freeze Id",
      "type": "string"
    },
    "source_access_ledger_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Access Ledger Receipt Id",
      "type": "string"
    },
    "support_audit_receipt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Support Audit Receipt Ids",
      "type": "array"
    },
    "terminal_status": {
      "enum": [
        "pass",
        "extension_required",
        "fail_no_saturation",
        "failed_integrity"
      ],
      "title": "Terminal Status",
      "type": "string"
    },
    "verification_completed": {
      "const": true,
      "default": true,
      "title": "Verification Completed",
      "type": "boolean"
    },
    "verified_artifact_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Verified Artifact Sha256S",
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "execution_bundle_id",
    "execution_authority_id",
    "selection_freeze_id",
    "feature_selection_result_id",
    "sample_size_selection_result_id",
    "feature_ranking_receipt_id",
    "sampler_evidence_id",
    "sampler_restart_receipt_id",
    "feature_refit_replay_receipt_id",
    "sample_refit_replay_receipt_id",
    "support_audit_receipt_ids",
    "source_access_ledger_receipt_id",
    "monitor_receipt_id",
    "inner_publication_manifest_id",
    "verified_artifact_sha256s",
    "terminal_status",
    "may_parent_g00d"
  ],
  "title": "G00CDecisionReceiptV5",
  "type": "object"
}
