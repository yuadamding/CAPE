{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SourceHashBinding": {
      "additionalProperties": false,
      "description": "One immutable source identity in a format-upgrade amendment.",
      "properties": {
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_file_sha256"
      ],
      "title": "SourceHashBinding",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00-source-plane-v2-amendment.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "No-model provenance bridge from accepted Dev29 v1 evidence to v2.",
  "properties": {
    "amendment_id": {
      "title": "Amendment Id",
      "type": "string"
    },
    "builder_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Builder Implementation Sha256",
      "type": "string"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "immutable_source_hashes": {
      "items": {
        "$ref": "#/$defs/SourceHashBinding"
      },
      "title": "Immutable Source Hashes",
      "type": "array"
    },
    "model_fitting_performed": {
      "const": false,
      "default": false,
      "title": "Model Fitting Performed",
      "type": "boolean"
    },
    "parent_g00a_v1": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "parent_g00a_v1_authority_id": {
      "minLength": 1,
      "title": "Parent G00A V1 Authority Id",
      "type": "string"
    },
    "parent_g00b_v1_manifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "parent_g00b_v1_virtual_store_id": {
      "minLength": 1,
      "title": "Parent G00B V1 Virtual Store Id",
      "type": "string"
    },
    "protected_outcome_scientific_use": {
      "const": false,
      "default": false,
      "title": "Protected Outcome Scientific Use",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "v2_guide_target_crosswalk": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "v2_numerical_audit": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "v2_row_locator": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "v2_source_derivation_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "amendment_id",
    "parent_g00a_v1_authority_id",
    "parent_g00a_v1",
    "parent_g00b_v1_virtual_store_id",
    "parent_g00b_v1_manifest",
    "immutable_source_hashes",
    "v2_guide_target_crosswalk",
    "v2_numerical_audit",
    "v2_source_derivation_receipt",
    "v2_row_locator",
    "builder_implementation_sha256",
    "environment_hash"
  ],
  "title": "G00SourcePlaneV2Amendment",
  "type": "object"
}
