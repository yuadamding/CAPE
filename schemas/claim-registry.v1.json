{
  "$defs": {
    "ClaimRecord": {
      "additionalProperties": false,
      "description": "One preregistered G14 claim key and its allowable interpretation.",
      "properties": {
        "candidate": {
          "minLength": 1,
          "title": "Candidate",
          "type": "string"
        },
        "claim_family": {
          "enum": [
            "P",
            "M",
            "E",
            "G"
          ],
          "title": "Claim Family",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "comparator": {
          "minLength": 1,
          "title": "Comparator",
          "type": "string"
        },
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "lower",
            "higher"
          ],
          "title": "Direction",
          "type": "string"
        },
        "eligible_wording": {
          "minLength": 1,
          "title": "Eligible Wording",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "external_independence_class": {
          "default": "not_external",
          "enum": [
            "not_external",
            "unresolved_blocked",
            "same_data_reexpression",
            "shared_samples_distinct_assay",
            "distinct_samples_same_study",
            "independent_study"
          ],
          "title": "External Independence Class",
          "type": "string"
        },
        "forbidden_wording": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Wording",
          "type": "array"
        },
        "multiplicity_method": {
          "enum": [
            "paired_max_statistic",
            "joint_max_statistic",
            "holm_fwer",
            "westfall_young",
            "bh_fdr",
            "descriptive_only"
          ],
          "title": "Multiplicity Method",
          "type": "string"
        },
        "parent_claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Claim Ids",
          "type": "array"
        },
        "primary_or_secondary": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Primary Or Secondary",
          "type": "string"
        },
        "resampling_unit": {
          "minLength": 1,
          "title": "Resampling Unit",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "component_id",
        "endpoint",
        "candidate",
        "comparator",
        "direction",
        "primary_or_secondary",
        "claim_family",
        "resampling_unit",
        "multiplicity_method",
        "eligible_wording",
        "forbidden_wording"
      ],
      "title": "ClaimRecord",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/claim-registry.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable preregistered claim universe for G14.",
  "properties": {
    "frozen_before_first_relevant_outer_evaluation": {
      "const": true,
      "default": true,
      "title": "Frozen Before First Relevant Outer Evaluation",
      "type": "boolean"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ClaimRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "registry_id": {
      "title": "Registry Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "registry_id",
    "records"
  ],
  "title": "ClaimRegistry",
  "type": "object"
}
