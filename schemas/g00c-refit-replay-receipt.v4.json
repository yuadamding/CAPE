{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-refit-replay-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Checkpoint-indexed sufficient statistics independently derived from source bytes.",
  "properties": {
    "candidate_kind": {
      "enum": [
        "feature_count",
        "training_cells"
      ],
      "title": "Candidate Kind",
      "type": "string"
    },
    "candidate_values": {
      "items": {
        "type": "integer"
      },
      "title": "Candidate Values",
      "type": "array"
    },
    "checkpoint_ids": {
      "default": [
        "Rest",
        "Stim8hr",
        "Stim48hr"
      ],
      "items": {
        "enum": [
          "Rest",
          "Stim8hr",
          "Stim48hr"
        ],
        "type": "string"
      },
      "title": "Checkpoint Ids",
      "type": "array"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "feature_statistics_identical_before_prefix": {
      "const": true,
      "default": true,
      "title": "Feature Statistics Identical Before Prefix",
      "type": "boolean"
    },
    "fit_row_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Fit Row Hashes",
      "type": "array"
    },
    "modeled_feature_count": {
      "enum": [
        256,
        512,
        1024,
        2048,
        4096
      ],
      "title": "Modeled Feature Count",
      "type": "integer"
    },
    "nested_cell_prefixes_verified": {
      "const": true,
      "default": true,
      "title": "Nested Cell Prefixes Verified",
      "type": "boolean"
    },
    "preregistered_audit_draw_ids": {
      "default": [
        0,
        6,
        12,
        18,
        24,
        30,
        36,
        42,
        48,
        58
      ],
      "items": {
        "type": "integer"
      },
      "title": "Preregistered Audit Draw Ids",
      "type": "array"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "reference_candidate": {
      "exclusiveMinimum": 0,
      "title": "Reference Candidate",
      "type": "integer"
    },
    "refit_records": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "replayed_rows": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "sampler_evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampler Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_schedule_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Schedule Id",
      "type": "string"
    },
    "selected_and_reference_all_59_draws": {
      "const": true,
      "default": true,
      "title": "Selected And Reference All 59 Draws",
      "type": "boolean"
    },
    "selected_candidate": {
      "exclusiveMinimum": 0,
      "title": "Selected Candidate",
      "type": "integer"
    },
    "selection_freeze_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Freeze Id",
      "type": "string"
    },
    "source_access_ledger_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Access Ledger Receipt Id",
      "type": "string"
    },
    "source_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Id",
      "type": "string"
    },
    "source_derived_statistics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    },
    "thinning_trace_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Thinning Trace Hash",
      "type": "string"
    },
    "training_count_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Training Count Hash",
      "type": "string"
    },
    "training_shape": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "const": 4096,
          "type": "integer"
        }
      ],
      "title": "Training Shape",
      "type": "array"
    },
    "validation_count_vector_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Count Vector Hash",
      "type": "string"
    },
    "validation_row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Row Hash",
      "type": "string"
    },
    "validation_shape": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "const": 3,
          "type": "integer"
        },
        {
          "const": 4096,
          "type": "integer"
        }
      ],
      "title": "Validation Shape",
      "type": "array"
    },
    "validation_vectors_identical_across_candidates": {
      "const": true,
      "default": true,
      "title": "Validation Vectors Identical Across Candidates",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "execution_authority_id",
    "selection_freeze_id",
    "seed_schedule_id",
    "source_binding_id",
    "sampler_evidence_id",
    "source_access_ledger_receipt_id",
    "candidate_kind",
    "selected_candidate",
    "reference_candidate",
    "modeled_feature_count",
    "candidate_values",
    "refit_records",
    "source_derived_statistics",
    "replayed_rows",
    "fit_row_hashes",
    "validation_row_hash",
    "training_count_hash",
    "validation_count_vector_hash",
    "thinning_trace_hash",
    "training_shape",
    "validation_shape"
  ],
  "title": "G00CRefitReplayReceiptV4",
  "type": "object"
}
