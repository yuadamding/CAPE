{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/legacy-parent-attestation-receipt.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Passed decision receipt for one exact wrapper and historical parent.",
  "properties": {
    "all_authoritative_files_covered": {
      "title": "All Authoritative Files Covered",
      "type": "boolean"
    },
    "attestation": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "attestation_id": {
      "minLength": 1,
      "title": "Attestation Id",
      "type": "string"
    },
    "legacy_sha256sums_verified": {
      "title": "Legacy Sha256Sums Verified",
      "type": "boolean"
    },
    "model_fitting_performed": {
      "const": false,
      "default": false,
      "title": "Model Fitting Performed",
      "type": "boolean"
    },
    "original_atomicity_not_claimed": {
      "title": "Original Atomicity Not Claimed",
      "type": "boolean"
    },
    "parent_g00a_g00b_relationship_verified": {
      "title": "Parent G00A G00B Relationship Verified",
      "type": "boolean"
    },
    "parent_g00a_v1_verified": {
      "title": "Parent G00A V1 Verified",
      "type": "boolean"
    },
    "parent_g00b_v1_verified": {
      "title": "Parent G00B V1 Verified",
      "type": "boolean"
    },
    "parent_writes_performed": {
      "const": false,
      "default": false,
      "title": "Parent Writes Performed",
      "type": "boolean"
    },
    "protected_expression_scientifically_used": {
      "const": false,
      "default": false,
      "title": "Protected Expression Scientifically Used",
      "type": "boolean"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_matrix_access_performed": {
      "const": false,
      "default": false,
      "title": "Source Matrix Access Performed",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "test_contract_id": {
      "minLength": 1,
      "title": "Test Contract Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "test_contract_id",
    "attestation_id",
    "attestation",
    "legacy_sha256sums_verified",
    "all_authoritative_files_covered",
    "parent_g00a_v1_verified",
    "parent_g00b_v1_verified",
    "parent_g00a_g00b_relationship_verified",
    "original_atomicity_not_claimed",
    "status"
  ],
  "title": "LegacyParentAttestationReceiptV1",
  "type": "object"
}
