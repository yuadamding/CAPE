{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-support-audit-receipt.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Support metrics independently derived from a verified sampler trace.",
  "properties": {
    "derived_support_table": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "sampler_evidence": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "sampler_evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampler Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    },
    "support_contract": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "support_contract_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Support Contract Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "execution_authority_id",
    "support_contract",
    "support_contract_id",
    "sampler_evidence",
    "sampler_evidence_id",
    "derived_support_table",
    "implementation_sha256"
  ],
  "title": "G00CSupportAuditReceiptV3",
  "type": "object"
}
