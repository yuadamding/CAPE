{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/shard-build-checkpoint.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_offsets_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Offsets Sha256"
    },
    "active_shard_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Shard Index"
    },
    "active_shard_nonzeros": {
      "default": 0,
      "minimum": 0,
      "title": "Active Shard Nonzeros",
      "type": "integer"
    },
    "active_shard_rows": {
      "default": 0,
      "minimum": 0,
      "title": "Active Shard Rows",
      "type": "integer"
    },
    "build_plan_id": {
      "title": "Build Plan Id",
      "type": "string"
    },
    "committed_chunks": {
      "default": 0,
      "minimum": 0,
      "title": "Committed Chunks",
      "type": "integer"
    },
    "completed_shard_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Completed Shard Hashes",
      "type": "array"
    },
    "nonzero_count": {
      "minimum": 0,
      "title": "Nonzero Count",
      "type": "integer"
    },
    "rng_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_cursor": {
      "minimum": 0,
      "title": "Source Cursor",
      "type": "integer"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "temporary_shard_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Temporary Shard Ids",
      "type": "array"
    }
  },
  "required": [
    "build_plan_id",
    "source_cursor",
    "completed_shard_hashes",
    "row_count",
    "nonzero_count"
  ],
  "title": "ShardBuildCheckpoint",
  "type": "object"
}
