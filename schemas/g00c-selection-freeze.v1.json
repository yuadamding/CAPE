      "description": "Finalized Dev33-B prerequisite that is forbidden as a claim parent.",
      "properties": {
        "authority_archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Authority Archive Sha256",
          "type": "string"
        },
        "authority_archive_uri": {
          "minLength": 1,
          "title": "Authority Archive Uri",
          "type": "string"
        },
        "canary_contract_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canary Contract Id",
          "type": "string"
        },
        "compact_payload_reuse_permitted": {
          "const": false,
          "default": false,
          "title": "Compact Payload Reuse Permitted",
          "type": "boolean"
        },
        "dev33_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Dev33 Code Commit",
          "type": "string"
        },
        "dev33_wheel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dev33 Wheel Sha256",
          "type": "string"
        },
