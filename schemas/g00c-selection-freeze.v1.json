{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FoldRowRoleRecord": {
      "additionalProperties": false,
      "description": "One frozen row role in a fold-native extraction.",
      "properties": {
        "role": {
          "enum": [
            "training_fit",
            "training_validation",
            "heldout_source_query",
            "protected_heldout_stimulated"
          ],
          "title": "Role",
          "type": "string"
        },
        "row_ids_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Row Ids Hash",
          "type": "string"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "rows",
        "row_ids_hash"
      ],
      "title": "FoldRowRoleRecord",
      "type": "object"
    },
    "G00CCanaryPrerequisiteV1": {
