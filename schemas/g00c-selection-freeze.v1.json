          "title": "Feature Artifact Reuse Permitted",
          "type": "boolean"
        },
        "final_audit_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Audit Id",
          "type": "string"
        },
        "independent_verification_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Independent Verification Id",
          "type": "string"
        },
        "parent_eligible": {
          "const": false,
          "default": false,
          "title": "Parent Eligible",
          "type": "boolean"
        },
        "prerequisite_satisfied": {
          "const": true,
          "default": true,
          "title": "Prerequisite Satisfied",
          "type": "boolean"
        },
        "promotion_eligible": {
          "const": false,
          "default": false,
          "title": "Promotion Eligible",
          "type": "boolean"
        },
        "row_artifact_reuse_permitted": {
          "const": false,
          "default": false,
          "title": "Row Artifact Reuse Permitted",
          "type": "boolean"
        },
        "sampler_artifact_reuse_permitted": {
          "const": false,
          "default": false,
          "title": "Sampler Artifact Reuse Permitted",
