          "title": "Evidence Role",
          "type": "string"
        },
        "execution_record_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Execution Record Commit",
          "type": "string"
        },
        "feature_artifact_reuse_permitted": {
          "const": false,
