    "G00CCommonSupportFeatureMetricV1": {
      "additionalProperties": false,
      "description": "Common 4,096-feature scoring surface for every prefix candidate.",
      "properties": {
        "candidate_distribution": {
          "const": "prefix_plus_residual_category_v1",
          "default": "prefix_plus_residual_category_v1",
          "title": "Candidate Distribution",
          "type": "string"
