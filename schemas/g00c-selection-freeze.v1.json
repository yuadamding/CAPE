        "candidate_feature_counts": {
          "default": [
            256,
            512,
            1024,
            2048,
            4096
          ],
          "items": {
            "type": "integer"
          },
          "title": "Candidate Feature Counts",
          "type": "array"
        },
        "checkpoint_ids": {
          "default": [
            "Rest",
            "Stim8hr",
            "Stim48hr"
          ],
          "items": {
            "enum": [
              "Rest",
              "Stim8hr",
              "Stim48hr"
            ],
            "type": "string"
          },
          "title": "Checkpoint Ids",
          "type": "array"
        },
        "comparison": {
          "const": "q95_absolute_paired_nll_difference_to_4096",
          "default": "q95_absolute_paired_nll_difference_to_4096",
          "title": "Comparison",
          "type": "string"
        },
        "custom001_puror_excluded": {
          "const": true,
          "default": true,
          "title": "Custom001 Puror Excluded",
          "type": "boolean"
        },
        "feature_equivalence_epsilon": {
          "const": 0.0001,
          "default": 0.0001,
          "title": "Feature Equivalence Epsilon",
          "type": "number"
        },
        "inverse_probability_weights_paired": {
          "const": true,
          "default": true,
          "title": "Inverse Probability Weights Paired",
          "type": "boolean"
        },
        "metric_unit": {
          "const": "nats_per_weighted_validation_count",
          "default": "nats_per_weighted_validation_count",
          "title": "Metric Unit",
          "type": "string"
        },
        "omitted_mass_expansion": {
          "const": "frozen_checkpoint_specific_training_only_frequency_vector_v1",
          "default": "frozen_checkpoint_specific_training_only_frequency_vector_v1",
          "title": "Omitted Mass Expansion",
          "type": "string"
        },
        "reference_feature_count": {
          "const": 4096,
          "default": 4096,
          "title": "Reference Feature Count",
          "type": "integer"
        },
        "residual_frequency_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "residual_frequency_fit_rows_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Residual Frequency Fit Rows Hash",
          "type": "string"
        },
        "selection_rule": {
          "const": "smallest_qualifying_prefix_v1",
          "default": "smallest_qualifying_prefix_v1",
          "title": "Selection Rule",
          "type": "string"
        },
        "validation_count_total": {
          "const": "identical_across_feature_candidates",
          "default": "identical_across_feature_candidates",
          "title": "Validation Count Total",
          "type": "string"
        },
        "validation_support": {
          "const": "same_frozen_4096_features_for_every_candidate",
          "default": "same_frozen_4096_features_for_every_candidate",
          "title": "Validation Support",
          "type": "string"
        }
      },
      "required": [
        "residual_frequency_artifact",
        "residual_frequency_fit_rows_hash"
      ],
      "title": "G00CCommonSupportFeatureMetricV1",
      "type": "object"
    },
    "G00CFeatureRankingFreezeV1": {
      "additionalProperties": false,
