{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-inner-publication-manifest.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cycle-free inner execution publication; the final decision is deliberately absent.",
  "properties": {
    "artifact_inventory": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "artifact_inventory_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Inventory Id",
      "type": "string"
    },
    "committed": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "destination_preexisted": {
      "const": false,
      "default": false,
      "title": "Destination Preexisted",
      "type": "boolean"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "feature_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Selection Result Id",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_written_last": {
      "const": true,
      "default": true,
      "title": "Manifest Written Last",
      "type": "boolean"
    },
    "no_clobber": {
      "const": true,
      "default": true,
      "title": "No Clobber",
      "type": "boolean"
    },
    "publication_event_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "publisher_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Publisher Implementation Sha256",
      "type": "string"
    },
    "sample_size_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Size Selection Result Id",
      "type": "string"
    },
    "sampler_evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampler Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection_freeze_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Freeze Id",
      "type": "string"
    },
    "sha256sums": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "terminal_status": {
      "enum": [
        "pass",
        "extension_required",
        "fail_no_saturation",
        "failed_integrity"
      ],
      "title": "Terminal Status",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "execution_authority_id",
    "selection_freeze_id",
    "feature_selection_result_id",
    "sample_size_selection_result_id",
    "sampler_evidence_id",
    "terminal_status",
    "artifact_inventory",
    "artifact_inventory_id",
    "sha256sums",
    "committed",
    "publication_event_receipt",
    "publisher_implementation_sha256"
  ],
  "title": "G00CInnerPublicationManifestV4",
  "type": "object"
}
