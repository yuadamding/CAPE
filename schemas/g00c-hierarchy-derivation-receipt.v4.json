{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-hierarchy-derivation-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Independent reconstruction of every hierarchy field from G00B metadata.",
  "properties": {
    "expression_values_accessed": {
      "const": false,
      "default": false,
      "title": "Expression Values Accessed",
      "type": "boolean"
    },
    "guide_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Guide Code Sha256",
      "type": "string"
    },
    "hierarchy": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "is_control_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Is Control Sha256",
      "type": "string"
    },
    "locator_and_crosswalk_rederived": {
      "const": true,
      "default": true,
      "title": "Locator And Crosswalk Rederived",
      "type": "boolean"
    },
    "ordered_row_ids_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Row Ids Sha256",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "row_count": {
      "exclusiveMinimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Id",
      "type": "string"
    },
    "source_index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Index Sha256",
      "type": "string"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    },
    "target_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Code Sha256",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "source_binding_id",
    "hierarchy",
    "row_count",
    "ordered_row_ids_sha256",
    "source_index_sha256",
    "target_code_sha256",
    "guide_code_sha256",
    "is_control_sha256"
  ],
  "title": "G00CHierarchyDerivationReceiptV4",
  "type": "object"
}
