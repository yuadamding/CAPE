{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FoldRowRoleRecord": {
      "additionalProperties": false,
      "description": "One frozen row role in a fold-native extraction.",
      "properties": {
        "role": {
          "enum": [
            "training_fit",
            "training_validation",
            "heldout_source_query",
            "protected_heldout_stimulated"
          ],
          "title": "Role",
          "type": "string"
        },
        "row_ids_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Row Ids Hash",
          "type": "string"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "rows",
        "row_ids_hash"
      ],
      "title": "FoldRowRoleRecord",
      "type": "object"
    },
    "G00CCommonSupportPriorV2": {
      "additionalProperties": false,
      "description": "Dev35 prior that is identical per primary gene on the 4,096-gene support.",
      "properties": {
        "common_support_probabilities_strictly_positive": {
          "const": true,
          "default": true,
          "title": "Common Support Probabilities Strictly Positive",
          "type": "boolean"
        },
        "modeled_feature_prior": {
          "const": "0.5_per_primary_feature",
          "default": "0.5_per_primary_feature",
          "title": "Modeled Feature Prior",
          "type": "string"
        },
        "per_feature_pseudocount": {
          "const": 0.5,
          "default": 0.5,
          "title": "Per Feature Pseudocount",
          "type": "number"
        },
        "reference_feature_count": {
          "const": 4096,
          "default": 4096,
          "title": "Reference Feature Count",
          "type": "integer"
        },
        "residual_category_prior": {
          "const": "0.5_times_omitted_feature_count",
          "default": "0.5_times_omitted_feature_count",
          "title": "Residual Category Prior",
          "type": "string"
        },
        "residual_frequencies_strictly_positive": {
          "const": true,
          "default": true,
          "title": "Residual Frequencies Strictly Positive",
          "type": "boolean"
        },
        "residual_frequency_estimator": {
          "const": "checkpoint_training_counts_plus_0.5_per_omitted_feature_v1",
          "default": "checkpoint_training_counts_plus_0.5_per_omitted_feature_v1",
          "title": "Residual Frequency Estimator",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "selection_threshold": {
          "const": 0.0001,
          "default": 0.0001,
          "title": "Selection Threshold",
          "type": "number"
        },
        "simulation_sensitivity_required_before_expression_access": {
          "const": false,
          "default": false,
          "title": "Simulation Sensitivity Required Before Expression Access",
          "type": "boolean"
        }
      },
      "title": "G00CCommonSupportPriorV2",
      "type": "object"
    },
    "G00CImplementationAuthorityV3": {
      "additionalProperties": false,
      "description": "Dev37 release and complete verifier implementation authority.",
      "properties": {
        "dev37_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Dev37 Code Commit",
          "type": "string"
        },
        "environment_kind": {
          "enum": [
            "exact_local_lock",
            "oci_container"
          ],
          "title": "Environment Kind",
          "type": "string"
        },
        "environment_lock": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "execution_environment_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Environment Digest",
          "type": "string"
        },
        "implementation_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Tree Sha256",
          "type": "string"
        },
        "implementations": {
          "items": {
            "$ref": "#/$defs/G00CImplementationBindingV3"
          },
          "title": "Implementations",
          "type": "array"
        },
        "normalized_sdist": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": 3,
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "wheel": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "dev37_code_commit",
        "wheel",
        "normalized_sdist",
        "implementation_tree_sha256",
        "environment_lock",
        "environment_kind",
        "execution_environment_digest",
        "implementations"
      ],
      "title": "G00CImplementationAuthorityV3",
      "type": "object"
    },
    "G00CImplementationBindingV3": {
      "additionalProperties": false,
      "description": "One exact Dev37 implementation surface.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "role": {
          "enum": [
            "feature_ranking",
            "source_authority",
            "hierarchy_derivation",
            "refit",
            "sampler",
            "support_auditor",
            "monitor",
            "source_access_auditor",
            "materialization_verifier",
            "refit_replay_verifier",
            "publication_verifier",
            "restart_verifier",
            "extension_verifier",
            "execution_verifier",
            "decision_verifier"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "artifact"
      ],
      "title": "G00CImplementationBindingV3",
      "type": "object"
    },
    "G00CSourceFileBindingV4": {
      "additionalProperties": false,
      "description": "One ordered immutable source in the accepted G00B plane.",
      "properties": {
        "checkpoint": {
          "enum": [
            "Rest",
            "Stim8hr",
            "Stim48hr"
          ],
          "title": "Checkpoint",
          "type": "string"
        },
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "checkpoint",
        "source_file_sha256"
      ],
      "title": "G00CSourceFileBindingV4",
      "type": "object"
    },
    "G00CSourcePlaneBindingV4": {
      "additionalProperties": false,
      "description": "Dev37 descriptor from which the verifier constructs the source store itself.",
      "properties": {
        "accepted_g00b_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Accepted G00B Manifest Sha256",
          "type": "string"
        },
        "accepted_g00b_parent": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "canonical_feature_index": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "canonical_feature_index_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Feature Index Hash",
          "type": "string"
        },
        "feature_count": {
          "exclusiveMinimum": 1,
          "title": "Feature Count",
          "type": "integer"
        },
        "feature_permutations_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Permutations Sha256",
          "type": "string"
        },
        "full_store_verification_required": {
          "const": true,
          "default": true,
          "title": "Full Store Verification Required",
          "type": "boolean"
        },
        "guide_target_crosswalk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Guide Target Crosswalk Sha256",
          "type": "string"
        },
        "puro_r_canonical_index": {
          "minimum": 0,
          "title": "Puro R Canonical Index",
          "type": "integer"
        },
        "puro_r_feature_id": {
          "const": "CUSTOM001_PuroR",
          "default": "CUSTOM001_PuroR",
          "title": "Puro R Feature Id",
          "type": "string"
        },
        "row_locator_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Row Locator Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 4,
          "default": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_authority_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Authority Id",
          "type": "string"
        },
        "source_files": {
          "items": {
            "$ref": "#/$defs/G00CSourceFileBindingV4"
          },
          "title": "Source Files",
          "type": "array"
        },
        "virtual_store_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Virtual Store Id",
          "type": "string"
        },
        "virtual_store_relative_uri": {
          "minLength": 1,
          "title": "Virtual Store Relative Uri",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "accepted_g00b_parent",
        "accepted_g00b_manifest_sha256",
        "virtual_store_id",
        "source_authority_id",
        "virtual_store_relative_uri",
        "canonical_feature_index",
        "canonical_feature_index_hash",
        "row_locator_sha256",
        "feature_permutations_sha256",
        "guide_target_crosswalk_sha256",
        "source_files",
        "feature_count",
        "puro_r_canonical_index"
      ],
      "title": "G00CSourcePlaneBindingV4",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-d1-execution-authority-freeze.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Dev37 expression-free D1 authority with source and sampler closure.",
  "properties": {
    "authority_archive_required": {
      "const": true,
      "default": true,
      "title": "Authority Archive Required",
      "type": "boolean"
    },
    "authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authority Id",
      "type": "string"
    },
    "base_sampler_expected_trace_rows": {
      "exclusiveMinimum": 0,
      "title": "Base Sampler Expected Trace Rows",
      "type": "integer"
    },
    "base_sampler_plan": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "base_sampler_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Sampler Plan Id",
      "type": "string"
    },
    "base_support_audit_contract": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "biological_claims": {
      "const": false,
      "default": false,
      "title": "Biological Claims",
      "type": "boolean"
    },
    "common_support_prior": {
      "$ref": "#/$defs/G00CCommonSupportPriorV2"
    },
    "expression_access_authorized_by_this_record": {
      "const": false,
      "default": false,
      "title": "Expression Access Authorized By This Record",
      "type": "boolean"
    },
    "expression_values_accessed_during_freeze": {
      "const": false,
      "default": false,
      "title": "Expression Values Accessed During Freeze",
      "type": "boolean"
    },
    "feature_reference_rows": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "feature_reference_rows_are_first_million": {
      "const": true,
      "default": true,
      "title": "Feature Reference Rows Are First Million",
      "type": "boolean"
    },
    "feature_reference_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Reference Rows Hash",
      "type": "string"
    },
    "fresh_attempt_id": {
      "minLength": 1,
      "title": "Fresh Attempt Id",
      "type": "string"
    },
    "hierarchy_derivation_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "implementation": {
      "$ref": "#/$defs/G00CImplementationAuthorityV3"
    },
    "monitored_process_tree_ceiling_bytes": {
      "const": 68719476736,
      "default": 68719476736,
      "title": "Monitored Process Tree Ceiling Bytes",
      "type": "integer"
    },
    "nested_training_row_order": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "nested_training_row_order_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nested Training Row Order Hash",
      "type": "string"
    },
    "outer_split_id": {
      "const": "lodo-D1",
      "default": "lodo-D1",
      "title": "Outer Split Id",
      "type": "string"
    },
    "prior_attempt_artifact_reuse_permitted": {
      "const": false,
      "default": false,
      "title": "Prior Attempt Artifact Reuse Permitted",
      "type": "boolean"
    },
    "protected_heldout_expression_values_accessed_during_freeze": {
      "const": false,
      "default": false,
      "title": "Protected Heldout Expression Values Accessed During Freeze",
      "type": "boolean"
    },
    "publication_root_uri": {
      "minLength": 1,
      "title": "Publication Root Uri",
      "type": "string"
    },
    "row_role_freeze": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "row_roles": {
      "items": {
        "$ref": "#/$defs/FoldRowRoleRecord"
      },
      "title": "Row Roles",
      "type": "array"
    },
    "sampler_hierarchy_rows": {
      "exclusiveMinimum": 0,
      "title": "Sampler Hierarchy Rows",
      "type": "integer"
    },
    "sampler_row_hierarchy": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_schedule": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "seed_schedule_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Schedule Id",
      "type": "string"
    },
    "selection_freeze": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "selection_freeze_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Freeze Id",
      "type": "string"
    },
    "source_plane": {
      "$ref": "#/$defs/G00CSourcePlaneBindingV4"
    },
    "status": {
      "const": "finalized_preaccess_not_executed",
      "default": "finalized_preaccess_not_executed",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "authority_id",
    "selection_freeze",
    "selection_freeze_id",
    "row_role_freeze",
    "row_roles",
    "nested_training_row_order",
    "nested_training_row_order_hash",
    "feature_reference_rows",
    "feature_reference_rows_hash",
    "sampler_row_hierarchy",
    "sampler_hierarchy_rows",
    "hierarchy_derivation_receipt",
    "source_plane",
    "seed_schedule",
    "seed_schedule_id",
    "base_sampler_plan",
    "base_sampler_plan_id",
    "base_sampler_expected_trace_rows",
    "common_support_prior",
    "base_support_audit_contract",
    "implementation",
    "fresh_attempt_id",
    "publication_root_uri"
  ],
  "title": "G00CD1ExecutionAuthorityFreezeV3",
  "type": "object"
}
