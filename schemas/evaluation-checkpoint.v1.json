{
  "$id": "https://credo.local/schemas/evaluation-checkpoint.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_chunks": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Completed Chunks",
      "type": "array"
    },
    "compute_used": {
      "minimum": 0,
      "title": "Compute Used",
      "type": "number"
    },
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "noise_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Noise Plan Hash",
      "type": "string"
    },
    "output_bytes_used": {
      "minimum": 0,
      "title": "Output Bytes Used",
      "type": "integer"
    },
    "particle_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Particle Plan Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "evaluation_id",
    "completed_chunks",
    "particle_plan_hash",
    "noise_plan_hash",
    "output_bytes_used",
    "compute_used"
  ],
  "title": "EvaluationCheckpoint",
  "type": "object"
}
