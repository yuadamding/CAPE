{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-feature-ranking-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source-derived checkpoint-conditioned Poisson-deviance feature ranking.",
  "properties": {
    "canonical_feature_index_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Feature Index Hash",
      "type": "string"
    },
    "checkpoint_ids": {
      "default": [
        "Rest",
        "Stim8hr",
        "Stim48hr"
      ],
      "items": {
        "enum": [
          "Rest",
          "Stim8hr",
          "Stim48hr"
        ],
        "type": "string"
      },
      "title": "Checkpoint Ids",
      "type": "array"
    },
    "complete_ranking": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "exact_id_index_mapping_verified": {
      "const": true,
      "default": true,
      "title": "Exact Id Index Mapping Verified",
      "type": "boolean"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "fit_row_count": {
      "exclusiveMinimum": 0,
      "title": "Fit Row Count",
      "type": "integer"
    },
    "fit_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fit Rows Hash",
      "type": "string"
    },
    "method": {
      "const": "checkpoint_conditioned_poisson_deviance_v1",
      "default": "checkpoint_conditioned_poisson_deviance_v1",
      "title": "Method",
      "type": "string"
    },
    "ordered_feature_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Feature Hash",
      "type": "string"
    },
    "puro_r_canonical_index": {
      "minimum": 0,
      "title": "Puro R Canonical Index",
      "type": "integer"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "scores_recomputed_from_source": {
      "const": true,
      "default": true,
      "title": "Scores Recomputed From Source",
      "type": "boolean"
    },
    "selected_prefix_count": {
      "const": 4096,
      "default": 4096,
      "title": "Selected Prefix Count",
      "type": "integer"
    },
    "selected_prefix_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selected Prefix Hash",
      "type": "string"
    },
    "source_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Id",
      "type": "string"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "execution_authority_id",
    "source_binding_id",
    "fit_rows_hash",
    "fit_row_count",
    "complete_ranking",
    "ordered_feature_hash",
    "selected_prefix_hash",
    "canonical_feature_index_hash",
    "puro_r_canonical_index"
  ],
  "title": "G00CFeatureRankingReceiptV4",
  "type": "object"
}
