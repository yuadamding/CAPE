{
  "$id": "https://credo.local/schemas/g00c-decision-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Artifact-derived Dev36 decision and sole successor G00D parent gate.",
  "properties": {
    "biological_claims": {
      "const": false,
      "default": false,
      "title": "Biological Claims",
      "type": "boolean"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "execution_bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Bundle Id",
      "type": "string"
    },
    "feature_refit_replay_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Refit Replay Receipt Id",
      "type": "string"
    },
    "feature_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Selection Result Id",
      "type": "string"
    },
    "materialization_receipt_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Materialization Receipt Id"
    },
    "may_parent_g00d": {
      "title": "May Parent G00D",
      "type": "boolean"
    },
    "publication_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Publication Manifest Id",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "sample_refit_replay_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Refit Replay Receipt Id",
      "type": "string"
    },
    "sample_size_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Size Selection Result Id",
      "type": "string"
    },
    "sampler_evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampler Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection_freeze_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Freeze Id",
      "type": "string"
    },
    "support_audit_receipt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Support Audit Receipt Ids",
      "type": "array"
    },
    "terminal_status": {
      "enum": [
        "pass",
        "extension_required",
        "fail_no_saturation",
        "failed_integrity"
      ],
      "title": "Terminal Status",
      "type": "string"
    },
    "verification_completed": {
      "const": true,
      "default": true,
      "title": "Verification Completed",
      "type": "boolean"
    },
    "verified_artifact_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Verified Artifact Sha256S",
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "execution_bundle_id",
    "execution_authority_id",
    "selection_freeze_id",
    "feature_selection_result_id",
    "sample_size_selection_result_id",
    "sampler_evidence_id",
    "feature_refit_replay_receipt_id",
    "sample_refit_replay_receipt_id",
    "support_audit_receipt_ids",
    "publication_manifest_id",
    "verified_artifact_sha256s",
    "terminal_status",
    "may_parent_g00d"
  ],
  "title": "G00CDecisionReceiptV4",
  "type": "object"
}
