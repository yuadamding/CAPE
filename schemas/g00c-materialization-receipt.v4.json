{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-materialization-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Dev37 materialization wrapper with monitor, ledger, and durable writer restart.",
  "properties": {
    "base_materialization_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "base_materialization_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Materialization Receipt Id",
      "type": "string"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "monitor_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "monitor_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Monitor Receipt Id",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_access_ledger_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_access_ledger_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Access Ledger Receipt Id",
      "type": "string"
    },
    "source_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Id",
      "type": "string"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    },
    "writer_restart_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "writer_restart_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Writer Restart Receipt Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "execution_authority_id",
    "source_binding_id",
    "base_materialization_receipt",
    "base_materialization_receipt_id",
    "source_access_ledger_receipt",
    "source_access_ledger_receipt_id",
    "monitor_receipt",
    "monitor_receipt_id",
    "writer_restart_receipt",
    "writer_restart_receipt_id"
  ],
  "title": "G00CMaterializationReceiptV4",
  "type": "object"
}
