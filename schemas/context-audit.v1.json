{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/context-audit.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effective_rank_threshold": {
      "default": 2,
      "minimum": 2,
      "title": "Effective Rank Threshold",
      "type": "integer"
    },
    "held_out_pool_information_set": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Held Out Pool Information Set",
      "type": "string"
    },
    "maximum_condition_number": {
      "default": 50.0,
      "exclusiveMinimum": 0,
      "title": "Maximum Condition Number",
      "type": "number"
    },
    "maximum_interaction_rank": {
      "default": 4,
      "maximum": 4,
      "minimum": 1,
      "title": "Maximum Interaction Rank",
      "type": "integer"
    },
    "observation_operator": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "parameter_match_fraction": {
      "default": 0.01,
      "maximum": 0.01,
      "minimum": 0,
      "title": "Parameter Match Fraction",
      "type": "number"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "singular_ratio_threshold": {
      "default": 0.05,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Singular Ratio Threshold",
      "type": "number"
    }
  },
  "required": [
    "held_out_pool_information_set",
    "observation_operator"
  ],
  "title": "ContextAuditContract",
  "type": "object"
}
