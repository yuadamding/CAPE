{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/sealed-run.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_audit": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evaluations",
      "type": "array"
    },
    "inference": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sealed_id": {
      "title": "Sealed Id",
      "type": "string"
    }
  },
  "required": [
    "sealed_id",
    "inference",
    "evaluations",
    "claim_audit"
  ],
  "title": "SealedRunManifest",
  "type": "object"
}
