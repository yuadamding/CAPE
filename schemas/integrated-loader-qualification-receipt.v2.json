{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "G00DParityGateEvidence": {
      "additionalProperties": false,
      "description": "Per-gate exact or numerical parity evidence.",
      "properties": {
        "comparison_mode": {
          "enum": [
            "exact_hash",
            "exact_or_numerical",
            "numerical_tolerance"
          ],
          "title": "Comparison Mode",
          "type": "string"
        },
        "gate": {
          "enum": [
            "row_ids",
            "raw_counts",
            "sample_weights",
            "thinning_rng",
            "loss",
            "gradient",
            "parameter",
            "interrupted_resume"
          ],
          "title": "Gate",
          "type": "string"
        },
        "maximum_absolute_error": {
          "minimum": 0,
          "title": "Maximum Absolute Error",
          "type": "number"
        },
        "maximum_relative_error": {
          "minimum": 0,
          "title": "Maximum Relative Error",
          "type": "number"
        },
        "observed_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Sha256",
          "type": "string"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "comparison_mode",
        "reference_sha256",
        "observed_sha256",
        "maximum_absolute_error",
        "maximum_relative_error"
      ],
      "title": "G00DParityGateEvidence",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/integrated-loader-qualification-receipt.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Dev31 observed G00D performance, parity, and memory evidence.",
  "properties": {
    "cache_policy": {
      "minLength": 1,
      "title": "Cache Policy",
      "type": "string"
    },
    "cold_start_measured": {
      "title": "Cold Start Measured",
      "type": "boolean"
    },
    "container_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Container Digest",
      "type": "string"
    },
    "cpu_count": {
      "minimum": 1,
      "title": "Cpu Count",
      "type": "integer"
    },
    "cuda_error_count": {
      "minimum": 0,
      "title": "Cuda Error Count",
      "type": "integer"
    },
    "cuda_version": {
      "minLength": 1,
      "title": "Cuda Version",
      "type": "string"
    },
    "data_wait_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Data Wait Fraction",
      "type": "number"
    },
    "gpu_count": {
      "minimum": 1,
      "title": "Gpu Count",
      "type": "integer"
    },
    "gpu_name": {
      "minLength": 1,
      "title": "Gpu Name",
      "type": "string"
    },
    "gpu_uuid": {
      "minLength": 1,
      "title": "Gpu Uuid",
      "type": "string"
    },
    "loader_error_count": {
      "minimum": 0,
      "title": "Loader Error Count",
      "type": "integer"
    },
    "lru_bound_pass": {
      "title": "Lru Bound Pass",
      "type": "boolean"
    },
    "macrobatch_cells": {
      "exclusiveMinimum": 0,
      "title": "Macrobatch Cells",
      "type": "integer"
    },
    "maximum_parity_absolute_error": {
      "minimum": 0,
      "title": "Maximum Parity Absolute Error",
      "type": "number"
    },
    "maximum_parity_relative_error": {
      "minimum": 0,
      "title": "Maximum Parity Relative Error",
      "type": "number"
    },
    "maximum_rss_excursion_bytes": {
      "minimum": 0,
      "title": "Maximum Rss Excursion Bytes",
      "type": "integer"
    },
    "measured_updates": {
      "exclusiveMinimum": 0,
      "title": "Measured Updates",
      "type": "integer"
    },
    "measurement_evidence": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "measurement_protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Measurement Protocol Sha256",
      "type": "string"
    },
    "median_compute_seconds": {
      "minimum": 0,
      "title": "Median Compute Seconds",
      "type": "number"
    },
    "median_data_wait_seconds": {
      "minimum": 0,
      "title": "Median Data Wait Seconds",
      "type": "number"
    },
    "memory_growth_pass": {
      "title": "Memory Growth Pass",
      "type": "boolean"
    },
    "memory_trace_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "microbatch_cells": {
      "exclusiveMinimum": 0,
      "title": "Microbatch Cells",
      "type": "integer"
    },
    "microbatches_per_update": {
      "exclusiveMinimum": 0,
      "title": "Microbatches Per Update",
      "type": "integer"
    },
    "monitor_error_count": {
      "minimum": 0,
      "title": "Monitor Error Count",
      "type": "integer"
    },
    "p95_batch_ready_seconds": {
      "minimum": 0,
      "title": "P95 Batch Ready Seconds",
      "type": "number"
    },
    "p95_compute_seconds": {
      "minimum": 0,
      "title": "P95 Compute Seconds",
      "type": "number"
    },
    "parity_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "parity_gates": {
      "items": {
        "$ref": "#/$defs/G00DParityGateEvidence"
      },
      "title": "Parity Gates",
      "type": "array"
    },
    "peak_aggregate_worker_rss_bytes": {
      "minimum": 0,
      "title": "Peak Aggregate Worker Rss Bytes",
      "type": "integer"
    },
    "peak_loader_rss_bytes": {
      "minimum": 0,
      "title": "Peak Loader Rss Bytes",
      "type": "integer"
    },
    "peak_open_file_handles": {
      "minimum": 0,
      "title": "Peak Open File Handles",
      "type": "integer"
    },
    "peak_open_shards": {
      "minimum": 0,
      "title": "Peak Open Shards",
      "type": "integer"
    },
    "peak_process_loader_rss_bytes": {
      "minimum": 0,
      "title": "Peak Process Loader Rss Bytes",
      "type": "integer"
    },
    "prefetch_depth": {
      "minimum": 1,
      "title": "Prefetch Depth",
      "type": "integer"
    },
    "qualification_contract_id": {
      "title": "Qualification Contract Id",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "rss_slope_bytes_per_second": {
      "title": "Rss Slope Bytes Per Second",
      "type": "number"
    },
    "rss_slope_upper_ci_bytes_per_second": {
      "title": "Rss Slope Upper Ci Bytes Per Second",
      "type": "number"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "steady_state_gpu_utilization": {
      "maximum": 1,
      "minimum": 0,
      "title": "Steady State Gpu Utilization",
      "type": "number"
    },
    "steady_state_measured": {
      "title": "Steady State Measured",
      "type": "boolean"
    },
    "storage_authority_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Storage Authority Hash",
      "type": "string"
    },
    "telemetry_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "telemetry_interval_seconds": {
      "exclusiveMinimum": 0,
      "title": "Telemetry Interval Seconds",
      "type": "number"
    },
    "torch_version": {
      "minLength": 1,
      "title": "Torch Version",
      "type": "string"
    },
    "warmup_updates": {
      "exclusiveMinimum": 0,
      "title": "Warmup Updates",
      "type": "integer"
    },
    "worker_count": {
      "minimum": 1,
      "title": "Worker Count",
      "type": "integer"
    }
  },
  "required": [
    "receipt_id",
    "qualification_contract_id",
    "gpu_name",
    "gpu_uuid",
    "gpu_count",
    "cuda_version",
    "torch_version",
    "container_digest",
    "worker_count",
    "cpu_count",
    "storage_authority_hash",
    "microbatch_cells",
    "microbatches_per_update",
    "macrobatch_cells",
    "prefetch_depth",
    "warmup_updates",
    "measured_updates",
    "cold_start_measured",
    "steady_state_measured",
    "cache_policy",
    "measurement_protocol_sha256",
    "measurement_evidence",
    "telemetry_artifact",
    "parity_artifact",
    "memory_trace_artifact",
    "telemetry_interval_seconds",
    "median_compute_seconds",
    "p95_compute_seconds",
    "median_data_wait_seconds",
    "p95_batch_ready_seconds",
    "data_wait_fraction",
    "steady_state_gpu_utilization",
    "peak_loader_rss_bytes",
    "peak_process_loader_rss_bytes",
    "peak_aggregate_worker_rss_bytes",
    "peak_open_shards",
    "peak_open_file_handles",
    "rss_slope_bytes_per_second",
    "rss_slope_upper_ci_bytes_per_second",
    "maximum_rss_excursion_bytes",
    "parity_gates",
    "lru_bound_pass",
    "loader_error_count",
    "cuda_error_count",
    "monitor_error_count",
    "maximum_parity_absolute_error",
    "maximum_parity_relative_error",
    "memory_growth_pass",
    "status"
  ],
  "title": "IntegratedLoaderQualificationReceiptV2",
  "type": "object"
}
