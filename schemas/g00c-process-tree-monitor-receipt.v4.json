{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-process-tree-monitor-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Out-of-process process-tree RSS and temporal-coverage evidence.",
  "properties": {
    "access_end_monotonic_ns": {
      "minimum": 0,
      "title": "Access End Monotonic Ns",
      "type": "integer"
    },
    "access_start_monotonic_ns": {
      "minimum": 0,
      "title": "Access Start Monotonic Ns",
      "type": "integer"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "descendants_observed": {
      "minimum": 0,
      "title": "Descendants Observed",
      "type": "integer"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "maximum_consecutive_unreadable_samples": {
      "minimum": 0,
      "title": "Maximum Consecutive Unreadable Samples",
      "type": "integer"
    },
    "maximum_process_tree_rss_bytes": {
      "minimum": 0,
      "title": "Maximum Process Tree Rss Bytes",
      "type": "integer"
    },
    "maximum_temporal_gap_milliseconds": {
      "minimum": 0,
      "title": "Maximum Temporal Gap Milliseconds",
      "type": "number"
    },
    "monitor_end_monotonic_ns": {
      "minimum": 0,
      "title": "Monitor End Monotonic Ns",
      "type": "integer"
    },
    "monitor_pid": {
      "exclusiveMinimum": 0,
      "title": "Monitor Pid",
      "type": "integer"
    },
    "monitor_ran_out_of_process": {
      "const": true,
      "default": true,
      "title": "Monitor Ran Out Of Process",
      "type": "boolean"
    },
    "monitor_start_monotonic_ns": {
      "minimum": 0,
      "title": "Monitor Start Monotonic Ns",
      "type": "integer"
    },
    "monitored_root_pid": {
      "exclusiveMinimum": 0,
      "title": "Monitored Root Pid",
      "type": "integer"
    },
    "process_tree_coverage_verified": {
      "const": true,
      "default": true,
      "title": "Process Tree Coverage Verified",
      "type": "boolean"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "samples": {
      "exclusiveMinimum": 1,
      "title": "Samples",
      "type": "integer"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "unreadable_samples": {
      "minimum": 0,
      "title": "Unreadable Samples",
      "type": "integer"
    }
  },
  "required": [
    "receipt_id",
    "execution_authority_id",
    "attempt_id",
    "monitor_pid",
    "monitored_root_pid",
    "trace",
    "samples",
    "maximum_process_tree_rss_bytes",
    "unreadable_samples",
    "maximum_consecutive_unreadable_samples",
    "maximum_temporal_gap_milliseconds",
    "descendants_observed",
    "access_start_monotonic_ns",
    "access_end_monotonic_ns",
    "monitor_start_monotonic_ns",
    "monitor_end_monotonic_ns"
  ],
  "title": "G00CProcessTreeMonitorReceiptV4",
  "type": "object"
}
