{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/particle-engine-qualification-bundle.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable T04 numerical particle-engine qualification bundle.",
  "properties": {
    "deterministic_drift": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "ecology": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "method": {
      "const": "streaming_euler_maruyama_v1",
      "title": "Method",
      "type": "string"
    },
    "ou_grid": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "particle_grid": {
      "items": {
        "type": "integer"
      },
      "title": "Particle Grid",
      "type": "array"
    },
    "qualification_id": {
      "title": "Qualification Id",
      "type": "string"
    },
    "reaction_mass": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_count": {
      "minimum": 1,
      "title": "Seed Count",
      "type": "integer"
    },
    "step_grid": {
      "items": {
        "type": "integer"
      },
      "title": "Step Grid",
      "type": "array"
    },
    "test_contract_id": {
      "title": "Test Contract Id",
      "type": "string"
    },
    "test_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "qualification_id",
    "test_contract_id",
    "method",
    "environment_hash",
    "particle_grid",
    "step_grid",
    "seed_count",
    "deterministic_drift",
    "ou_grid",
    "reaction_mass",
    "ecology",
    "lifecycle",
    "test_receipt"
  ],
  "title": "ParticleEngineQualificationBundle",
  "type": "object"
}
