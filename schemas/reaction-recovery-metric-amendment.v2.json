{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/reaction-recovery-metric-amendment.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable duration-correct R0/R1 evidence amendment over dev23 T07S.",
  "properties": {
    "amendment_id": {
      "title": "Amendment Id",
      "type": "string"
    },
    "bootstrap_target_draws": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "component_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "corrected_null_interval_refits": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "false_promotion_upper_limit": {
      "maximum": 0.05,
      "minimum": 0.05,
      "title": "False Promotion Upper Limit",
      "type": "number"
    },
    "legacy_null_refits": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "method": {
      "const": "t07s_interval_metric_amendment_v2",
      "title": "Method",
      "type": "string"
    },
    "metric_estimand": {
      "const": "centered_interval_log_frequency_change",
      "title": "Metric Estimand",
      "type": "string"
    },
    "null_model_effects": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "optimizer_rerun": {
      "const": false,
      "default": false,
      "title": "Optimizer Rerun",
      "type": "boolean"
    },
    "parent_artifacts_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Artifacts Manifest Sha256",
      "type": "string"
    },
    "parent_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Bundle Sha256",
      "type": "string"
    },
    "parent_qualification_id": {
      "title": "Parent Qualification Id",
      "type": "string"
    },
    "r0_metric_estimand": {
      "const": "centered_interval_log_frequency_change",
      "title": "R0 Metric Estimand",
      "type": "string"
    },
    "recovery_curve": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "recovery_series": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_model": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "target_metrics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "test_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "amendment_id",
    "method",
    "parent_qualification_id",
    "parent_bundle_sha256",
    "parent_artifacts_manifest_sha256",
    "metric_estimand",
    "r0_metric_estimand",
    "false_promotion_upper_limit",
    "environment_hash",
    "legacy_null_refits",
    "corrected_null_interval_refits",
    "null_model_effects",
    "recovery_curve",
    "recovery_series",
    "target_metrics",
    "bootstrap_target_draws",
    "selected_model",
    "test_receipt",
    "component_receipt"
  ],
  "title": "ReactionRecoveryMetricAmendment",
  "type": "object"
}
