{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/reaction-recovery-qualification-bundle.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable T07S learned constant-reaction qualification bundle.",
  "properties": {
    "bootstrap_target_draws": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "candidate_updates": {
      "items": {
        "type": "integer"
      },
      "title": "Candidate Updates",
      "type": "array"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "method": {
      "const": "complete_denominator_dm_reaction_recovery_v1",
      "title": "Method",
      "type": "string"
    },
    "null_audit_repeats": {
      "minimum": 59,
      "title": "Null Audit Repeats",
      "type": "integer"
    },
    "null_calibration_repeats": {
      "minimum": 59,
      "title": "Null Calibration Repeats",
      "type": "integer"
    },
    "null_model_effects": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "null_refits": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "pool_count": {
      "minimum": 2,
      "title": "Pool Count",
      "type": "integer"
    },
    "qualification_id": {
      "title": "Qualification Id",
      "type": "string"
    },
    "recovery_curve": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "recovery_series": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_model": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "target_count": {
      "minimum": 4,
      "title": "Target Count",
      "type": "integer"
    },
    "target_metrics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "test_contract_id": {
      "title": "Test Contract Id",
      "type": "string"
    },
    "test_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "qualification_id",
    "test_contract_id",
    "method",
    "environment_hash",
    "null_calibration_repeats",
    "null_audit_repeats",
    "candidate_updates",
    "target_count",
    "pool_count",
    "null_refits",
    "null_model_effects",
    "recovery_curve",
    "recovery_series",
    "target_metrics",
    "bootstrap_target_draws",
    "selected_model",
    "test_receipt"
  ],
  "title": "ReactionRecoveryQualificationBundle",
  "type": "object"
}
