{
  "$id": "https://credo.local/schemas/g14-seal-contract.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Final evidence-only stage; it cannot train, select, or discover.",
  "properties": {
    "claim_registry_id": {
      "title": "Claim Registry Id",
      "type": "string"
    },
    "g14_contract_id": {
      "title": "G14 Contract Id",
      "type": "string"
    },
    "model_fitting": {
      "const": false,
      "default": false,
      "title": "Model Fitting",
      "type": "boolean"
    },
    "model_selection": {
      "const": false,
      "default": false,
      "title": "Model Selection",
      "type": "boolean"
    },
    "multiplicity_contract_id": {
      "title": "Multiplicity Contract Id",
      "type": "string"
    },
    "purpose": {
      "const": "robustness_multiplicity_and_claim_sealing",
      "default": "robustness_multiplicity_and_claim_sealing",
      "title": "Purpose",
      "type": "string"
    },
    "required_outputs": {
      "items": {
        "enum": [
          "ROBUSTNESS_MATRIX.parquet",
          "SIMULTANEOUS_INTERVALS.parquet",
          "MULTIPLICITY_DECISION.json",
          "CLAIM_LEDGER.parquet",
          "FINAL_EVIDENCE_GRAPH.json",
          "FINAL_CLAIM_SEAL_RECEIPT.json",
          "SHA256SUMS"
        ],
        "type": "string"
      },
      "title": "Required Outputs",
      "type": "array"
    },
    "robustness_plan_id": {
      "title": "Robustness Plan Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_discovery": {
      "const": false,
      "default": false,
      "title": "Target Discovery",
      "type": "boolean"
    },
    "threshold_adjustment": {
      "const": false,
      "default": false,
      "title": "Threshold Adjustment",
      "type": "boolean"
    }
  },
  "required": [
    "g14_contract_id",
    "claim_registry_id",
    "robustness_plan_id",
    "multiplicity_contract_id",
    "required_outputs"
  ],
  "title": "G14SealContract",
  "type": "object"
}
