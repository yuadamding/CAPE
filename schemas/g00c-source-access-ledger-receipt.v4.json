{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-source-access-ledger-receipt.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Role-labelled ledger from which protected-expression access is derived.",
  "properties": {
    "access_rows": {
      "minimum": 0,
      "title": "Access Rows",
      "type": "integer"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "ledger": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "protected_expression_reads": {
      "const": 0,
      "default": 0,
      "title": "Protected Expression Reads",
      "type": "integer"
    },
    "protected_row_ids_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protected Row Ids Sha256",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "role_row_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Role Row Hashes",
      "type": "object"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Id",
      "type": "string"
    },
    "status": {
      "const": "pass",
      "default": "pass",
      "title": "Status",
      "type": "string"
    },
    "zero_protected_reads_derived_from_full_ledger": {
      "const": true,
      "default": true,
      "title": "Zero Protected Reads Derived From Full Ledger",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "execution_authority_id",
    "source_binding_id",
    "ledger",
    "access_rows",
    "role_row_hashes",
    "protected_row_ids_sha256"
  ],
  "title": "G00CSourceAccessLedgerReceiptV4",
  "type": "object"
}
