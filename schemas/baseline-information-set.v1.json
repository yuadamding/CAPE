{
  "$id": "https://credo.local/schemas/baseline-information-set.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Aggregation Hash",
      "type": "string"
    },
    "allowed_test_source_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Allowed Test Source Rows Hash",
      "type": "string"
    },
    "allowed_training_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Allowed Training Rows Hash",
      "type": "string"
    },
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "code_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Hash",
      "type": "string"
    },
    "denominator_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denominator Hash"
    },
    "forbidden_endpoint_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Forbidden Endpoint Rows Hash",
      "type": "string"
    },
    "representation_id": {
      "title": "Representation Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Plan Hash",
      "type": "string"
    },
    "split_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Split Hash",
      "type": "string"
    }
  },
  "required": [
    "baseline_id",
    "code_hash",
    "allowed_training_rows_hash",
    "allowed_test_source_rows_hash",
    "forbidden_endpoint_rows_hash",
    "split_hash",
    "representation_id",
    "aggregation_hash",
    "seed_plan_hash"
  ],
  "title": "BaselineInformationSet",
  "type": "object"
}
