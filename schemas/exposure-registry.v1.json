{
  "$defs": {
    "EvidenceRole": {
      "enum": [
        "development",
        "sealed",
        "external_confirmation"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "ExposureRecord": {
      "additionalProperties": false,
      "properties": {
        "endpoint_seen": {
          "title": "Endpoint Seen",
          "type": "boolean"
        },
        "exposure_role": {
          "$ref": "#/$defs/EvidenceRole",
          "default": "development"
        },
        "first_exposure_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Exposure Date"
        },
        "source_artifact_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Artifact Hash"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "unit_type": {
          "title": "Unit Type",
          "type": "string"
        },
        "used_for_architecture": {
          "default": false,
          "title": "Used For Architecture",
          "type": "boolean"
        },
        "used_for_biological_story": {
          "default": false,
          "title": "Used For Biological Story",
          "type": "boolean"
        },
        "used_for_hyperparameters": {
          "default": false,
          "title": "Used For Hyperparameters",
          "type": "boolean"
        },
        "used_for_thresholds": {
          "default": false,
          "title": "Used For Thresholds",
          "type": "boolean"
        }
      },
      "required": [
        "unit_type",
        "unit_id",
        "endpoint_seen"
      ],
      "title": "ExposureRecord",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/exposure-registry.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/ExposureRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "records"
  ],
  "title": "ExposureRegistry",
  "type": "object"
}
