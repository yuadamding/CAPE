{
  "$id": "https://credo.local/schemas/evaluation-plan.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Registry Hash",
      "type": "string"
    },
    "evaluation_plan_id": {
      "title": "Evaluation Plan Id",
      "type": "string"
    },
    "information_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Information Set Hash",
      "type": "string"
    },
    "multiplicity_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Multiplicity Plan Hash",
      "type": "string"
    },
    "one_shot_outer_access": {
      "const": true,
      "default": true,
      "title": "One Shot Outer Access",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "evaluation_plan_id",
    "run_id",
    "information_set_hash",
    "seed_plan_hash",
    "baseline_registry_hash",
    "multiplicity_plan_hash"
  ],
  "title": "EvaluationPlan",
  "type": "object"
}
