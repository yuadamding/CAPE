{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/input-view.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "estimability_pass": {
      "title": "Estimability Pass",
      "type": "boolean"
    },
    "fit_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fit Rows Hash",
      "type": "string"
    },
    "inner_validation_pass": {
      "title": "Inner Validation Pass",
      "type": "boolean"
    },
    "method": {
      "enum": [
        "identity_library_normalized",
        "matched_control_offset_v1"
      ],
      "title": "Method",
      "type": "string"
    },
    "parameter_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_parent_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Parent Hash",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected": {
      "title": "Selected",
      "type": "boolean"
    },
    "view_id": {
      "title": "View Id",
      "type": "string"
    },
    "zero_preserving": {
      "const": true,
      "default": true,
      "title": "Zero Preserving",
      "type": "boolean"
    }
  },
  "required": [
    "view_id",
    "method",
    "raw_parent_hash",
    "fit_rows_hash",
    "parameter_artifact",
    "estimability_pass",
    "inner_validation_pass",
    "selected"
  ],
  "title": "InputViewArtifact",
  "type": "object"
}
