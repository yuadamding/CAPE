{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/count-representation-bundle.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable T01 count-native representation qualification bundle.",
  "properties": {
    "candidate_metrics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "count_store_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Count Store Sha256",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "type": "integer"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "dynamics_gradients_enabled": {
      "const": false,
      "default": false,
      "title": "Dynamics Gradients Enabled",
      "type": "boolean"
    },
    "encoder_state": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "feature_index_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Index Hash",
      "type": "string"
    },
    "fit_checkpoint": {
      "title": "Fit Checkpoint",
      "type": "string"
    },
    "fold_index": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "method": {
      "const": "multinomial_hellinger_pca_v1",
      "title": "Method",
      "type": "string"
    },
    "null_calibration": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "outer_folds": {
      "items": {
        "type": "string"
      },
      "title": "Outer Folds",
      "type": "array"
    },
    "per_guide_metrics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "per_target_metrics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "pooled_data_id": {
      "title": "Pooled Data Id",
      "type": "string"
    },
    "protected_checkpoint": {
      "title": "Protected Checkpoint",
      "type": "string"
    },
    "representation_id": {
      "title": "Representation Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_dimensions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Selected Dimensions",
      "type": "object"
    },
    "selected_model": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "selection_uses_terminal_outcomes": {
      "const": false,
      "default": false,
      "title": "Selection Uses Terminal Outcomes",
      "type": "boolean"
    },
    "support_metrics": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "test_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "representation_id",
    "pooled_data_id",
    "method",
    "feature_index_hash",
    "count_store_sha256",
    "dimensions",
    "selected_dimensions",
    "outer_folds",
    "fit_checkpoint",
    "protected_checkpoint",
    "fold_index",
    "encoder_state",
    "candidate_metrics",
    "per_guide_metrics",
    "per_target_metrics",
    "support_metrics",
    "null_calibration",
    "selected_model",
    "test_receipt"
  ],
  "title": "CountRepresentationBundle",
  "type": "object"
}
