{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/state-selection-calibration.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen pooled calibration for nested state-family selection.",
  "properties": {
    "calibration_id": {
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Calibration Protocol Hash",
      "type": "string"
    },
    "calibration_stage": {
      "enum": [
        "development",
        "locked_audit"
      ],
      "title": "Calibration Stage",
      "type": "string"
    },
    "checkpoint_updates": {
      "items": {
        "type": "integer"
      },
      "title": "Checkpoint Updates",
      "type": "array"
    },
    "confidence_level": {
      "default": 0.95,
      "maximum": 0.95,
      "minimum": 0.95,
      "title": "Confidence Level",
      "type": "number"
    },
    "confidence_method": {
      "const": "clopper_pearson_one_sided",
      "default": "clopper_pearson_one_sided",
      "title": "Confidence Method",
      "type": "string"
    },
    "development_calibration_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Development Calibration Sha256"
    },
    "false_interaction_count": {
      "const": 0,
      "default": 0,
      "title": "False Interaction Count",
      "type": "integer"
    },
    "false_interaction_rate_upper_bound": {
      "maximum": 0.05,
      "minimum": 0.0,
      "title": "False Interaction Rate Upper Bound",
      "type": "number"
    },
    "false_joint_interaction_count": {
      "const": 0,
      "default": 0,
      "title": "False Joint Interaction Count",
      "type": "integer"
    },
    "false_joint_interaction_rate_upper_bound": {
      "maximum": 0.05,
      "minimum": 0.0,
      "title": "False Joint Interaction Rate Upper Bound",
      "type": "number"
    },
    "false_target_main_count": {
      "const": 0,
      "default": 0,
      "title": "False Target Main Count",
      "type": "integer"
    },
    "false_target_main_rate_upper_bound": {
      "maximum": 0.05,
      "minimum": 0.0,
      "title": "False Target Main Rate Upper Bound",
      "type": "number"
    },
    "familywise_error_target": {
      "default": 0.05,
      "exclusiveMinimum": 0.0,
      "maximum": 0.05,
      "title": "Familywise Error Target",
      "type": "number"
    },
    "interaction_minimum_improvement": {
      "exclusiveMinimum": 0.0,
      "title": "Interaction Minimum Improvement",
      "type": "number"
    },
    "method": {
      "const": "pooled_nested_two_null",
      "default": "pooled_nested_two_null",
      "title": "Method",
      "type": "string"
    },
    "repeated_per_null": {
      "minimum": 119,
      "title": "Repeated Per Null",
      "type": "integer"
    },
    "results_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_minimum_improvement": {
      "exclusiveMinimum": 0.0,
      "title": "Target Minimum Improvement",
      "type": "number"
    }
  },
  "required": [
    "calibration_id",
    "calibration_stage",
    "repeated_per_null",
    "false_target_main_rate_upper_bound",
    "false_interaction_rate_upper_bound",
    "false_joint_interaction_rate_upper_bound",
    "target_minimum_improvement",
    "interaction_minimum_improvement",
    "checkpoint_updates",
    "results_artifact",
    "calibration_protocol_hash"
  ],
  "title": "StateSelectionCalibration",
  "type": "object"
}
