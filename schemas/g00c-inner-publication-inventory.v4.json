{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "G00CSemanticPublicationArtifactV4": {
      "additionalProperties": false,
      "description": "One semantic role mapped to the exact bundle ArtifactRef and published filename.",
      "properties": {
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "published_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Published Sha256",
          "type": "string"
        },
        "published_size_bytes": {
          "minimum": 0,
          "title": "Published Size Bytes",
          "type": "integer"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "source_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "role",
        "filename",
        "source_artifact",
        "published_sha256",
        "published_size_bytes"
      ],
      "title": "G00CSemanticPublicationArtifactV4",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/g00c-inner-publication-inventory.v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Decision-free semantic inventory written as inner artifacts.json.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/G00CSemanticPublicationArtifactV4"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "final_decision_included": {
      "const": false,
      "default": false,
      "title": "Final Decision Included",
      "type": "boolean"
    },
    "inventory_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "terminal_status": {
      "enum": [
        "pass",
        "extension_required",
        "fail_no_saturation",
        "failed_integrity"
      ],
      "title": "Terminal Status",
      "type": "string"
    }
  },
  "required": [
    "inventory_id",
    "terminal_status",
    "artifacts"
  ],
  "title": "G00CInnerPublicationInventoryV4",
  "type": "object"
}
