{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ResolvedRunCapabilities": {
      "additionalProperties": false,
      "properties": {
        "decode_gene_composition": {
          "default": false,
          "title": "Decode Gene Composition",
          "type": "boolean"
        },
        "dynamic_context_counterfactual": {
          "default": false,
          "title": "Dynamic Context Counterfactual",
          "type": "boolean"
        },
        "fixed_context_counterfactual": {
          "default": false,
          "title": "Fixed Context Counterfactual",
          "type": "boolean"
        },
        "predict_relative_mass": {
          "default": false,
          "title": "Predict Relative Mass",
          "type": "boolean"
        },
        "predict_state": {
          "default": true,
          "title": "Predict State",
          "type": "boolean"
        },
        "resume_training": {
          "default": true,
          "title": "Resume Training",
          "type": "boolean"
        },
        "stream_terminal_particles": {
          "default": true,
          "title": "Stream Terminal Particles",
          "type": "boolean"
        },
        "target_reference_counterfactual": {
          "default": true,
          "title": "Target Reference Counterfactual",
          "type": "boolean"
        }
      },
      "title": "ResolvedRunCapabilities",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/inference-bundle.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/ResolvedRunCapabilities"
    },
    "compiled_run_id": {
      "title": "Compiled Run Id",
      "type": "string"
    },
    "evaluation_seed_plan": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "model": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "output_schema": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "recipe_id": {
      "const": "credo.count_sde_v4",
      "default": "credo.count_sde_v4",
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_version": {
      "const": "4.0.dev16",
      "default": "4.0.dev16",
      "title": "Recipe Version",
      "type": "string"
    },
    "run_contract": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_checkpoint_id": {
      "title": "Selected Checkpoint Id",
      "type": "string"
    },
    "selected_family": {
      "enum": [
        "configured_checkpoint",
        "gene_decoder_selected",
        "state_validation_selected",
        "global_terminal_null",
        "shrunk_sister_guide_target_terminal",
        "target_plus_source_target_interaction"
      ],
      "title": "Selected Family",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "run_id",
    "compiled_run_id",
    "selected_checkpoint_id",
    "selected_family",
    "selection",
    "model",
    "run_contract",
    "evaluation_seed_plan",
    "output_schema",
    "capabilities"
  ],
  "title": "InferenceBundleManifest",
  "type": "object"
}
