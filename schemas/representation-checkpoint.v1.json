{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/representation-checkpoint.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cell_sampler_cursor": {
      "minimum": 0,
      "title": "Cell Sampler Cursor",
      "type": "integer"
    },
    "loss_scale_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Loss Scale Hash",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "optimizer": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "representation_contract_id": {
      "title": "Representation Contract Id",
      "type": "string"
    },
    "rng": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_inner_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "update": {
      "minimum": 0,
      "title": "Update",
      "type": "integer"
    }
  },
  "required": [
    "representation_contract_id",
    "update",
    "model",
    "optimizer",
    "rng",
    "cell_sampler_cursor",
    "loss_scale_hash"
  ],
  "title": "RepresentationCheckpoint",
  "type": "object"
}
