{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "relative_uri": {
          "title": "Relative Uri",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "sha256",
        "size_bytes",
        "media_type",
        "relative_uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://credo.local/schemas/prepared-representation.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cache_generation_id": {
      "title": "Cache Generation Id",
      "type": "string"
    },
    "count_store": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "decoder_state": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "encoder_state": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "feature_index": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "fit_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fit Rows Hash",
      "type": "string"
    },
    "fit_selection": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "information_set": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "input_view": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "latent_cache": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "prepared_id": {
      "title": "Prepared Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state_dim": {
      "exclusiveMinimum": 0,
      "title": "State Dim",
      "type": "integer"
    },
    "validation_rows_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Rows Hash",
      "type": "string"
    }
  },
  "required": [
    "prepared_id",
    "cache_generation_id",
    "count_store",
    "information_set",
    "fit_selection",
    "input_view",
    "feature_index",
    "encoder_state",
    "decoder_state",
    "latent_cache",
    "fit_rows_hash",
    "validation_rows_hash",
    "state_dim"
  ],
  "title": "PreparedRepresentation",
  "type": "object"
}
