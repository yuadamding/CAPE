{
  "$id": "https://credo.local/schemas/g00c-decision-receipt.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Artifact-derived Dev35 terminal decision and sole G00D parent gate.",
  "properties": {
    "biological_claims": {
      "const": false,
      "default": false,
      "title": "Biological Claims",
      "type": "boolean"
    },
    "common_support_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Common Support Receipt Sha256",
      "type": "string"
    },
    "execution_authority_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Authority Id",
      "type": "string"
    },
    "execution_bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Bundle Id",
      "type": "string"
    },
    "feature_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Selection Result Id",
      "type": "string"
    },
    "grid_stage": {
      "enum": [
        "base",
        "extension"
      ],
      "title": "Grid Stage",
      "type": "string"
    },
    "may_parent_g00d": {
      "title": "May Parent G00D",
      "type": "boolean"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "sample_size_selection_result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Size Selection Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_schedule_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seed Schedule Id",
      "type": "string"
    },
    "selection_freeze_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Freeze Id",
      "type": "string"
    },
    "support_audit_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Support Audit Sha256S",
      "type": "array"
    },
    "terminal_status": {
      "enum": [
        "pass",
        "extension_required",
        "fail_no_saturation",
        "failed_integrity"
      ],
      "title": "Terminal Status",
      "type": "string"
    },
    "verification_completed": {
      "const": true,
      "default": true,
      "title": "Verification Completed",
      "type": "boolean"
    },
    "verified_artifact_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Verified Artifact Sha256S",
      "type": "array"
    },
    "verifier_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verifier Implementation Sha256",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "execution_bundle_id",
    "execution_authority_id",
    "selection_freeze_id",
    "feature_selection_result_id",
    "sample_size_selection_result_id",
    "seed_schedule_id",
    "common_support_receipt_sha256",
    "support_audit_sha256s",
    "verifier_implementation_sha256",
    "verified_artifact_sha256s",
    "grid_stage",
    "terminal_status",
    "may_parent_g00d"
  ],
  "title": "G00CDecisionReceiptV3",
  "type": "object"
}
