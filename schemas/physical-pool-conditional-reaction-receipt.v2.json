{
  "$id": "https://credo.local/schemas/physical-pool-conditional-reaction-receipt.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Numerical parity and exposed predictive decision for T07R-A0-v2.",
  "properties": {
    "bootstrap_draws_each": {
      "minimum": 1000,
      "title": "Bootstrap Draws Each",
      "type": "integer"
    },
    "conditional_dm_interval_95": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Conditional Dm Interval 95",
      "type": "array"
    },
    "conditional_multinomial_interval_95": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Conditional Multinomial Interval 95",
      "type": "array"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "estimator_effect_max_abs_error": {
      "minimum": 0,
      "title": "Estimator Effect Max Abs Error",
      "type": "number"
    },
    "estimator_effect_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Estimator Effect Tolerance",
      "type": "number"
    },
    "estimator_parity_pass": {
      "title": "Estimator Parity Pass",
      "type": "boolean"
    },
    "estimator_probability_max_abs_error": {
      "minimum": 0,
      "title": "Estimator Probability Max Abs Error",
      "type": "number"
    },
    "estimator_probability_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Estimator Probability Tolerance",
      "type": "number"
    },
    "evidence_role": {
      "const": "forensic_estimand_correction",
      "title": "Evidence Role",
      "type": "string"
    },
    "exposure_status": {
      "const": "historically_exposed_development",
      "title": "Exposure Status",
      "type": "string"
    },
    "factorization_max_abs_error": {
      "minimum": 0,
      "title": "Factorization Max Abs Error",
      "type": "number"
    },
    "factorization_pass": {
      "title": "Factorization Pass",
      "type": "boolean"
    },
    "factorization_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Factorization Tolerance",
      "type": "number"
    },
    "implementation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "m1_sister_target_nll": {
      "minimum": 0,
      "title": "M1 Sister Target Nll",
      "type": "number"
    },
    "m2_selected_policy_nll": {
      "minimum": 0,
      "title": "M2 Selected Policy Nll",
      "type": "number"
    },
    "metric_estimand": {
      "const": "physical_pool_conditional_p60_dm_nll_per_count",
      "title": "Metric Estimand",
      "type": "string"
    },
    "minimum_inner_fit_sisters": {
      "minimum": 1,
      "title": "Minimum Inner Fit Sisters",
      "type": "integer"
    },
    "minimum_outer_nonouter_sisters": {
      "minimum": 1,
      "title": "Minimum Outer Nonouter Sisters",
      "type": "integer"
    },
    "parent_components_verified": {
      "const": true,
      "default": true,
      "title": "Parent Components Verified",
      "type": "boolean"
    },
    "point_delta_m2_minus_m1": {
      "title": "Point Delta M2 Minus M1",
      "type": "number"
    },
    "predictive_decision": {
      "enum": [
        "m1_superior",
        "m2_superior",
        "inconclusive"
      ],
      "title": "Predictive Decision",
      "type": "string"
    },
    "protected_channels_pass": {
      "title": "Protected Channels Pass",
      "type": "boolean"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_update": {
      "minimum": 0,
      "title": "Selected Update",
      "type": "integer"
    },
    "status": {
      "enum": [
        "forensic_m1_superior",
        "forensic_m2_superior",
        "forensic_inconclusive"
      ],
      "title": "Status",
      "type": "string"
    },
    "test_contract_id": {
      "title": "Test Contract Id",
      "type": "string"
    },
    "zero_inner_fit_sister_guides": {
      "const": 0,
      "default": 0,
      "title": "Zero Inner Fit Sister Guides",
      "type": "integer"
    },
    "zero_outer_nonouter_sister_guides": {
      "const": 0,
      "default": 0,
      "title": "Zero Outer Nonouter Sister Guides",
      "type": "integer"
    }
  },
  "required": [
    "receipt_id",
    "test_contract_id",
    "status",
    "evidence_role",
    "exposure_status",
    "metric_estimand",
    "selected_update",
    "estimator_probability_max_abs_error",
    "estimator_probability_tolerance",
    "estimator_effect_max_abs_error",
    "estimator_effect_tolerance",
    "estimator_parity_pass",
    "factorization_max_abs_error",
    "factorization_tolerance",
    "factorization_pass",
    "m2_selected_policy_nll",
    "m1_sister_target_nll",
    "point_delta_m2_minus_m1",
    "predictive_decision",
    "conditional_multinomial_interval_95",
    "conditional_dm_interval_95",
    "bootstrap_draws_each",
    "minimum_inner_fit_sisters",
    "minimum_outer_nonouter_sisters",
    "protected_channels_pass",
    "config_hash",
    "implementation_hash",
    "environment_hash"
  ],
  "title": "PhysicalPoolConditionalReactionReceipt",
  "type": "object"
}
