include AGENTS.md CHANGELOG.md CITATION.cff LICENSE NOTICE README.md
recursive-include compatibility *.json
recursive-include docs *.md
recursive-include locks *.lock
recursive-include schemas *.json
recursive-include scripts *.py
recursive-include tests *.py
include vendor/README.md vendor/SHA256SUMS
prune build
prune dist
global-exclude __pycache__ *.py[cod]
